# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5443/app
APP_URL=http://localhost:5173

# Optional in dev: without SMTP_HOST login links are printed to the API log.
# In production (NODE_ENV=production) the API refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional. Empty DSN = GlitchTip off.
SENTRY_DSN=

# New accounts require an allowlisted address until Robin explicitly opens signup.
SIGNUP_ALLOWLIST=
SIGNUP_OPEN=
